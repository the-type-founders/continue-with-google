{
  "name": "@thetypefounders/continue-with-google",
  "version": "2.0.0",
  "license": "Apache-2.0",
  "author": "Ivan Ukhov <ivan.ukhov@gmail.com>",
  "description": "Browser authentication and API authorization with Google",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-type-founders/continue-with-google.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./authenticate.js": {
      "types": "./dist/authenticate.d.ts",
      "default": "./dist/authenticate.js"
    },
    "./authorize.js": {
      "types": "./dist/authorize.d.ts",
      "default": "./dist/authorize.js"
    },
    "./refresh.js": {
      "types": "./dist/refresh.d.ts",
      "default": "./dist/refresh.js"
    }
  },
  "dependencies": {
    "authenticator": "^1.1.5",
    "google-auth-library": "^11.0.2"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/authenticator": "^1.1.4",
    "@types/node": "^26.4.0",
    "dotenv": "^17.4.2",
    "prettier": "^3.9.6",
    "puppeteer": "^25.9.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "puppeteer": "^25.9.0"
  },
  "scripts": {
    "build": "tsc",
    "check": "prettier . --check",
    "format": "prettier . --check --write",
    "prepublish": "tsc",
    "test": "vitest --bail=1 --no-file-parallelism"
  }
}
